# Copy to .env.local and fill in values

# Neon Postgres — get from Neon console → Connection Details
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# App base URL (used for metadata canonical URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Resend — email / waitlist
# Create an audience named "manamap-waitlist" at resend.com/audiences
# and paste its ID below. Leave blank to skip in dev (console.log instead).
# RESEND_API_KEY=re_...
# RESEND_AUDIENCE_ID=...

# Clerk — get keys from clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Route URLs (must match app/sign-in and app/sign-up folder names)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# After sign-in → dashboard; after sign-up → onboarding
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboard
# Webhook secret — from clerk.com → Webhooks → your endpoint → Signing Secret
# Required events: user.created, user.updated
CLERK_WEBHOOK_SECRET=whsec_...

# Cloudflare R2 — image uploads (avatar / banner / featured)
# Create a bucket named "manamap-uploads" in Cloudflare R2.
# Create an API token with Object Read & Write on that bucket.
# Enable a Custom Domain (or the r2.dev public URL) for the bucket, then paste it below.
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=manamap-uploads
# Public base URL of the bucket — e.g. https://uploads.manamap.gg or https://pub-xxx.r2.dev
R2_PUBLIC_BASE_URL=https://pub-xxx.r2.dev

# PostHog — product analytics (optional, events are no-op if key is missing)
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry — error tracking (optional; omit DSN to disable)
# Get DSN from sentry.io → Project → Settings → Client Keys
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/yyy
# SENTRY_DSN=https://xxx@sentry.io/yyy
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=manamap-web
# SENTRY_AUTH_TOKEN=sntrys_...   (needed for source-map uploads on Vercel)

# Upstash Redis — waitlist rate limiting (5 signups/min per IP)
# Create a Redis database at upstash.com; copy the REST URL and token.
# Omit to disable rate limiting in dev.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxx...

# Launch flag — set to "true" to hide the pre-launch banner and flip the Sign-in link
# NEXT_PUBLIC_LAUNCHED=false

# YouTube Data API v3 — get a key from console.cloud.google.com → APIs → YouTube Data API v3
# YOUTUBE_API_KEY=AIza...

# Twitch Helix API — create an app at dev.twitch.tv/console/apps
# TWITCH_CLIENT_ID=...
# TWITCH_CLIENT_SECRET=...

# PDF generation — /api/c/[slug]/kit.pdf
# In production on Vercel, @sparticuz/chromium is used automatically.
# For local dev, set this to your installed Chrome/Chromium path:
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:   /usr/bin/google-chrome-stable
# CHROMIUM_EXECUTABLE_PATH=
